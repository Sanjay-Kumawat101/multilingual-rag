# Choose gemini, groq, openrouter, or ollama.
LLM_PROVIDER=gemini

# Set this to a model available to the selected provider.
LLM_MODEL=replace-with-your-model

# Set the provider key for hosted LLMs. Ollama does not require a key.
LLM_API_KEY=replace-with-your-api-key

# Optional OpenAI-compatible API URL override.
# LLM_BASE_URL=

# Optional second model used after temporary overload or rate-limit errors.
# LLM_FALLBACK_MODEL=

# Optional RAG and generation tuning. Defaults are shown.
# LLM_MAX_RETRIES=4
# TEMPERATURE=0.2
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MAX_SEQ_LENGTH=256
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# TOP_K=5
# MIN_SIMILARITY_SCORE=0.25
